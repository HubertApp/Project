# Copier en e2e/.env (gitignoré). Toutes les valeurs ont un défaut, le fichier est optionnel.

# Gateway Apollo Router : GraphQL à la racine, pas /graphql
GATEWAY_URL=http://localhost:4000/

# Jeton envoyé en Bearer par le serveur Front-admin (sa variable GATEWAY_KEY).
# Défaut identique à Front-admin : "<TOKEN>".
E2E_GATEWAY_KEY=

# Fournisseur du catalogue, comme le code en dur de Front-admin
E2E_FOURNISSEUR_ID=FR_TRANSPORT_GOUV

# Ce que l'admin tape dans le champ de recherche de la page d'ajout (nom ou ville)
E2E_DATASET_SEARCH=metz

# Durée max d'attente de l'ingestion GTFS, en secondes
E2E_INGESTION_TIMEOUT=180

# AD6 : durée max d'attente du mail admin dans les logs, et conteneurs lus
E2E_NOTIFICATION_TIMEOUT=60
E2E_ADMIN_WORKER_CONTAINER=ms-admin-worker
E2E_NOTIFICATIONS_CONTAINER=service-notifications

# Ce que l'utilisateur tape dans la barre de recherche pour trouver un arrêt du réseau
E2E_STOP_QUERIES=gare,place,mairie,eglise,centre,ecole,rue
